# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://........mongodb.net

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# Tiempo de vida del token (opcional, por defecto 1h)
JWT_EXPIRES_IN=1h

# Puerto local (opcional, por defecto 3000)
PORT=3000
